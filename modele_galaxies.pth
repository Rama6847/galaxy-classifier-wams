08]\n","output_type":"stream"},{"name":"stdout","text":"  ✅ Meilleur modèle sauvegardé (val_acc = 72.30%)\n📊 Epoch 16/20 - Temps: 13.8s\n   Train - Loss: 0.7002, Acc: 76.18%\n   Val   - Loss: 0.8191, Acc: 72.30%\n   💾 Checkpoint mis à jour (epoch 16)\n------------------------------------------------------------\n","output_type":"stream"},{"name":"stderr","text":"Epoch 17/20: 100%|██████████| 178/178 [00:11<00:00, 15.10it/s, loss=0.621]\n","output_type":"stream"},{"name":"stdout","text":"  ⏳ Pas d'amélioration (1/5)\n📊 Epoch 17/20 - Temps: 13.7s\n   Train - Loss: 0.6998, Acc: 76.10%\n   Val   - Loss: 0.8694, Acc: 70.72%\n   💾 Checkpoint mis à jour (epoch 17)\n------------------------------------------------------------\n","output_type":"stream"},{"name":"stderr","text":"Epoch 18/20: 100%|██████████| 178/178 [00:11<00:00, 14.96it/s, loss=0.61] \n","output_type":"stream"},{"name":"stdout","text":"  ✅ Meilleur modèle sauvegardé (val_acc = 73.89%)\n📊 Epoch 18/20 - Temps: 13.8s\n   Train - Loss: 0.6184, Acc: 78.90%\n   Val   - Loss: 0.7759, Acc: 73.89%\n   💾 Checkpoint mis à jour (epoch 18)\n------------------------------------------------------------\n","output_type":"stream"},{"name":"stderr","text":"Epoch 19/20: 100%|██████████| 178/178 [00:11<00:00, 14.96it/s, loss=0.442]\n","output_type":"stream"},{"name":"stdout","text":"  ✅ Meilleur modèle sauvegardé (val_acc = 74.24%)\n📊 Epoch 19/20 - Temps: 13.8s\n   Train - Loss: 0.6140, Acc: 79.41%\n   Val   - Loss: 0.7539, Acc: 74.24%\n   💾 Checkpoint mis à jour (epoch 19)\n------------------------------------------------------------\n","output_type":"stream"},{"name":"stderr","text":"Epoch 20/20: 100%|██████████| 178/178 [00:11<00:00, 15.14it/s, loss=0.464]\n","output_type":"stream"},{"name":"stdout","text":"  ⏳ Pas d'amélioration (1/5)\n📊 Epoch 20/20 - Temps: 13.7s\n   Train - Loss: 0.5938, Acc: 79.46%\n   Val   - Loss: 0.7529, Acc: 73.75%\n   💾 Checkpoint mis à jour (epoch 20)\n------------------------------------------------------------\n✅ Entraînement terminé - Meilleure validation accuracy: 74.24%\n","output_type":"stream"}],"execution_count":12},{"id":"b2e5a03b-8f95-42de-85ea-e9df0a8e5422","cell_type":"markdown","source":"## 9. Visualisations et évaluation sur le test set (après entraînement)","metadata":{}},{"id":"e178a0e1-fcc5-45b2-8220-b6572a936e74","cell_type":"code","source":"model.eval()\n\n# Évaluation sur test\ntest_correct = 0\ntest_total = 0\nall_preds = []\nall_labels = []\n\nwith torch.no_grad():\n    for images, labels in tqdm(test_loader, desc=\"Test\"):\n        images, labels = images.to(device), labels.to(device)\n        outputs = model(images)\n        _, pred = torch.max(outputs, 1)\n        test_total += labels.size(0)\n        test_correct += (pred == labels).sum().item()\n        all_preds.extend(pred.cpu().numpy())\n        all_labels.extend(labels.cpu().numpy())\n\ntest_acc = 100.0 * test_correct / test_total\nprint(f\"Test Accuracy: {test_acc:.2f}%\")","metadata":{"execution":{"iopub.status.busy":"2026-04-30T06:30:17.711180Z","iopub.execute_input":"2026-04-30T06:30:17.711795Z","iopub.status.idle":"2026-04-30T06:30:20.068177Z","shell.execute_reply.started":"2026-04-30T06:30:17.711761Z","shell.execute_reply":"2026-04-30T06:30:20.067205Z"},"trusted":true},"outputs":[{"name":"stderr","text":"Test: 100%|██████████| 56/56 [00:02<00:00, 23.88it/s]","output_type":"stream"},{"name":"stdout","text":"Test Accuracy: 76.44%\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":13},{"id":"1c97eeae-dcf8-4628-9b1b-fab81decf047","cell_type":"markdown","source":"### 9.1 Courbes d'apprentissage\n","metadata":{}},{"id":"c262af06-f826-4e04-9c2f-045c67b926ff","cell_type":"code","source":"import matplotlib.pyplot as plt\nimport pandas as pd\nimport seaborn as sns\nimport numpy as np\nplt.figure(figsize=(12, 5))\nplt.subplot(1, 2, 1)\nplt.plot(history['train_loss'], label='Train Loss')\nplt.plot(history['val_loss'], label='Val Loss')\nplt.xlabel('Epoch')\nplt.ylabel('Loss')\nplt.legend()\nplt.grid(True)\n\nplt.subplot(1, 2, 2)\nplt.plot(history['train_acc'], label='Train Acc')\nplt.plot(history['val_acc'], label='Val Acc')\nplt.xlabel('Epoch')\nplt.ylabel('Accuracy (%)')\nplt.legend()\nplt.grid(True)\n\nplt.tight_layout()\nplt.savefig(save_path + 'training_curves_2layers.png')\nplt.show()","metadata":{"execution":{"iopub.status.busy":"2026-04-30T06:30:35.860084Z","iopub.execute_input":"2026-04-30T06:30:35.860517Z","iopub.status.idle":"2026-04-30T06:30:36.704654Z","shell.execute_reply.started":"2026-04-30T06:30:35.860483Z","shell.execute_reply":"2026-04-30T06:30:36.703912Z"},"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":14},{"id":"01b22d72-1167-42f1-a536-022c5c2a686e","cell_type":"markdown","source":"### 9.2 Rapport de classification et matrice de confusion\n","metadata":{}},{"id":"53638293-4e87-4799-8908-615d1bc1c345","cell_type":"code","source":"import seaborn as sns\nclass_names = [\n    \"Disturbed\", \"Merging\", \"Round Smooth\", \"In-between Round Smooth\",\n    \"Cigar Shaped Smooth\", \"Barred Spiral\", \"Unbarred Tight Spiral\",\n    \"Unbarred Loose Spiral\", \"Edge-on without Bulge\", \"Edge-on with Bulge\"\n]\n\nprint(classification_report(all_labels, all_preds, target_names=class_names))\n\ncm = confusion_matrix(all_labels, all_preds)\nplt.figure(figsize=(12, 10))\nsns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)\nplt.xlabel('Predicted')\nplt.ylabel('True')\nplt.title('Confusion Matrix')\nplt.xticks(rotation=45, ha='right')\nplt.tight_layout()\nplt.savefig(save_path + 'confusion_matrix_2layers.png')\nplt.show()","metadata":{"execution":{"iopub.status.busy":"2026-04-30T06:30:45.547470Z","iopub.execute_input":"2026-04-30T06:30:45.547784Z","iopub.status.idle":"2026-04-30T06:30:46.304157Z","shell.execute_reply.started":"2026-04-30T06:30:45.547758Z","shell.execute_reply":"2026-04-30T06:30:46.303450Z"},"trusted":true},"outputs":[{"name":"stdout","text":"                         precision    recall  f1-score   support\n\n              Disturbed       0.60      0.28      0.39       204\n                Merging       0.82      0.81      0.81       373\n           Round Smooth       0.92      0.85      0.89       529\nIn-between Round Smooth       0.80      0.91      0.85       408\n    Cigar Shaped Smooth       0.56      0.63      0.59        71\n          Barred Spiral       0.72      0.79      0.75       436\n  Unbarred Tight Spiral       0.64      0.75      0.69       365\n  Unbarred Loose Spiral       0.63      0.61      0.62       516\n  Edge-on without Bulge       0.87      0.87      0.87       283\n     Edge-on with Bulge       0.83      0.85      0.84       363\n\n               accuracy                           0.76      3548\n              macro avg       0.74      0.74      0.73      3548\n           weighted avg       0.76      0.76      0.76      3548\n\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x1000 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":15},{"id":"674587d8-e20e-4458-80ef-c74b649c2e76","cell_type":"code","source":"# Sauvegarde du meilleur modèle\ntorch.save(model.state_dict(), '/kaggle/working/best_model3.pth')\nprint(\"✅ Modèle sauvegardé : best_model3.pth\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T06:31:53.720830Z","iopub.execute_input":"2026-04-30T06:31:53.721535Z","iopub.status.idle":"2026-04-30T06:31:53.732654Z","shell.execute_reply.started":"2026-04-30T06:31:53.721503Z","shell.execute_reply":"2026-04-30T06:31:53.731858Z"}},"outputs":[{"name":"stdout","text":"✅ Modèle sauvegardé : best_model3.pth\n","output_type":"stream"}],"execution_count":17}]}