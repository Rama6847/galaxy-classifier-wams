.execute_reply.started":"2026-04-30T06:16:08.650416Z","shell.execute_reply":"2026-04-30T06:16:08.965939Z"},"executionInfo":{"elapsed":32,"status":"ok","timestamp":1777066638482,"user":{"displayName":"Rama Kdj","userId":"05689091522843985216"},"user_tz":-60},"id":"j6IH6oRxYVwU","outputId":"f8f8820e-5ee7-43c2-9725-14c3fa39026f","trusted":true},"outputs":[{"name":"stdout","text":"Version de h5py installée : 3.15.1\nh5py version: 3.15.1\n","output_type":"stream"}],"execution_count":3},{"id":"c3f3103af0416e39","cell_type":"markdown","source":"### chargement de dataset","metadata":{"id":"c3f3103af0416e39"}},{"id":"Wb72OkWBZerh","cell_type":"code","source":"# 1. Supprimer l'ancien fichier corrompu\n\n#if os.path.exists(h5_path):\n#    os.remove(h5_path)\n#    print(\"✅ Ancien fichier corrompu supprimé.\")\n#else:\n#    print(\"ℹ️ Aucun fichier existant trouvé.\")\n\n# 2. Télécharger une copie saine (2.5 Go)\nprint(\"📥 Téléchargement du dataset (2.5 GB)...\")\n# Télécharger le fichier depuis l'URL officielle de Zenodo\n!wget -O /content/Galaxy10_DECals.h5 https://zenodo.org/records/10845026/files/Galaxy10_DECals.h5?download=1","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-04-30T06:16:14.487498Z","iopub.execute_input":"2026-04-30T06:16:14.488006Z","iopub.status.idle":"2026-04-30T06:18:28.583127Z","shell.execute_reply.started":"2026-04-30T06:16:14.487975Z","shell.execute_reply":"2026-04-30T06:18:28.582339Z"},"executionInfo":{"elapsed":116302,"status":"ok","timestamp":1777065010914,"user":{"displayName":"Rama Kdj","userId":"05689091522843985216"},"user_tz":-60},"id":"Wb72OkWBZerh","outputId":"c6b268df-04d4-4c14-e03e-2f410cad1993","trusted":true},"outputs":[{"name":"stdout","text":"📥 Téléchargement du dataset (2.5 GB)...\n--2026-04-30 06:16:14--  https://zenodo.org/records/10845026/files/Galaxy10_DECals.h5?download=1\nResolving zenodo.org (zenodo.org)... 137.138.153.219, 188.184.103.118, 137.138.52.235, ...\nConnecting to zenodo.org (zenodo.org)|137.138.153.219|:443... connected.\nHTTP request sent, awaiting response... 200 OK\nLength: 2735267419 (2.5G) [application/octet-stream]\nSaving to: ‘/content/Galaxy10_DECals.h5’\n\n/content/Galaxy10_D 100%[===================>]   2.55G   111MB/s    in 2m 14s  \n\n2026-04-30 06:18:28 (19.5 MB/s) - ‘/content/Galaxy10_DECals.h5’ saved [2735267419/2735267419]\n\n","output_type":"stream"}],"execution_count":4},{"id":"-TN7nXEgaHNx","cell_type":"code","source":"#verification du chargment du fichier\nimport hashlib\nimport os\n\ndef calculate_sha256(file_path):\n    sha256_hash = hashlib.sha256()\n    with open(file_path, \"rb\") as f:\n        for byte_block in iter(lambda: f.read(4096), b\"\"):\n            sha256_hash.update(byte_block)\n    return sha256_hash.hexdigest()\n\nfile_path = '/content/Galaxy10_DECals.h5'\nif os.path.exists(file_path):\n    file_hash = calculate_sha256(file_path)\n    print(f\"Checksum SHA256 de votre fichier : {file_hash}\")\n    # Comparez-le avec cette valeur (vous pouvez le faire manuellement)\n    # attendu = \"19AEFC477C41BB7F77FF07599A6B82A038DC042F889A111B0D4D98BB755C1571\"\nelse :\n print ( \"il existe pas\") ","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-04-30T06:19:54.009920Z","iopub.execute_input":"2026-04-30T06:19:54.010270Z","iopub.status.idle":"2026-04-30T06:20:02.737413Z","shell.execute_reply.started":"2026-04-30T06:19:54.010238Z","shell.execute_reply":"2026-04-30T06:20:02.736689Z"},"executionInfo":{"elapsed":23130,"status":"ok","timestamp":1777066670770,"user":{"displayName":"Rama Kdj","userId":"05689091522843985216"},"user_tz":-60},"id":"-TN7nXEgaHNx","outputId":"1fa43084-1b29-402d-ad84-303a3a9df488","trusted":true},"outputs":[{"name":"stdout","text":"Checksum SHA256 de votre fichier : 19aefc477c41bb7f77ff07599a6b82a038dc042f889a111b0d4d98bb755c1571\n","output_type":"stream"}],"execution_count":5},{"id":"9ee289fb7e9757d3","cell_type":"markdown","source":"### Division train/test/validation","metadata":{"id":"9ee289fb7e9757d3"}},{"id":"1ff5d898-a5d1-4184-9522-9d3ba9f68781","cell_type":"code","source":"import gc\n\n# Supprimer l'ancien dataset s'il existe pour libérer la RAM\nif 'dataset' in locals() or 'dataset' in globals():\n    del dataset\n    gc.collect()\n    print(\"Ancien dataset supprimé et RAM libérée.\")\n","metadata":{"execution":{"iopub.status.busy":"2026-04-26T20:06:04.296224Z","iopub.execute_input":"2026-04-26T20:06:04.297063Z","iopub.status.idle":"2026-04-26T20:06:04.301514Z","shell.execute_reply.started":"2026-04-26T20:06:04.297031Z","shell.execute_reply":"2026-04-26T20:06:04.300342Z"},"trusted":true},"outputs":[],"execution_count":37},{"id":"0e755100-051e-429c-8a4b-0c5dcf5976ff","cell_type":"code","source":"import gc\nimport torch\nimport sys\n\n# 1. Supprimer les grosses variables si elles existent\nvars_to_kill = ['dataset', 'train_loader', 'test_loader', 'model', 'optimizer', 'x_train', 'y_train']\nfor var in vars_to_kill:\n    if var in globals():\n        del globals()[var]\n\n# 2. Libérer la RAM système (Garbage Collector)\ngc.collect()\n\n# 3. Libérer la VRAM (Mémoire GPU)\n# Pour PyTorch\nif torch.cuda.is_available():\n    torch.cuda.empty_cache()\n    torch.cuda.ipc_collect()\n\n\n\nprint(\"🧹 Nettoyage terminé : La RAM et le GPU sont prêts pour le prochain modèle.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-26T21:04:12.781540Z","iopub.execute_input":"2026-04-26T21:04:12.781841Z","iopub.status.idle":"2026-04-26T21:04:13.053213Z","shell.execute_reply.started":"2026-04-26T21:04:12.781818Z","shell.execute_reply":"2026-04-26T21:04:13.052568Z"}},"outputs":[{"name":"stdout","text":"🧹 Nettoyage terminé : La RAM et le GPU sont prêts pour le prochain modèle.\n","output_type":"stream"}],"execution_count":9},{"id":"42dbb624-0efc-4699-b74f-e4daf7944247","cell_type":"code","source":"import h5py\nimport torch\nfrom torch.utils.data import Dataset, DataLoader, Subset\nfrom sklearn.model_selection import train_test_split\nfrom torchvision import transforms\n\n# ============================================\n# 1. DÉFINIR LA CLASSE DATASET\n# ============================================\nclass Galaxy10Dataset(Dataset):\n    def __init__(self, h5_path, transform=None, normalize=True):\n        print(\"Chargement du dataset en RAM (patience...)\")\n        with h5py.File(h5_path, 'r') as f:\n            self.images = torch.tensor(f['images'][:], dtype=torch.float32)\n            self.labels = torch.tensor(f['ans'][:], dtype=torch.long)\n        \n        if normalize:\n            self.images = self.images / 255.0\n        \n        # (N, H, W, C) -> (N, C, H, W)\n        self.images = self.images.permute(0, 3, 1, 2)\n        self.transform = transform\n        print(f\"✅ {len(self.labels)} images chargées !\")\n\n    def __len__(self):\n        return len(self.labels)\n\n    def __getitem__(self, idx):\n        image = self.images[idx]\n        label = self.labels[idx]\n        if self.transform:\n            image = self.transform(image)\n        return image, label\n\n# ============================================\n# 2. TRANSFORMATIONS POUR 96×96\n# ============================================\ntrain_transform = transforms.Compose([\n    transforms.Resize((96, 96)),           # Redimensionnement à 96×96\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomRotation(15),\n])\n\nval_test_transform = transforms.Compose([\n    transforms.Resize((96, 96)),           # Redimensionnement uniquement\n])\n\n# ============================================\n# 3. CHARGEMENT ET DIVISION\n# ============================================\ndataset = Galaxy10Dataset('/content/Galaxy10_DECals.h5', transform=None, normalize=True)\n\nindices = list(range(len(dataset)))\ntrain_indices, test_indices = train_test_split(indices, test_size=0.2, random_state=42)\ntrain_indices, val_indices = train_test_split(train_indices, test_size=0.2, random_state=42)\n\nprint(f\"Train: {len(train_indices)}, Val: {len(val_indices)}, Test: {len(test_indices)}\")\n\n# ============================================\n# 4. APPLICATION DES TRANSFORMATIONS\n# ============================================\nclass TransformedSubset:\n    def __init__(self, subset, transform):\n        self.subset = subset\n        self.transform = transform\n    def __len__(self):\n        return len(self.subset)\n    def __getitem__(self, idx):\n        image, label = self.subset[idx]\n        if self.transform:\n            image = self.transform(image)\n        return image, label\n\ntrain_dataset = TransformedSubset(Subset(dataset, train_indices), train_transform)\nval_dataset = TransformedSubset(Subset(dataset, val_indices), val_test_transform)\ntest_dataset = TransformedSubset(Subset(dataset, test_indices), val_test_transform)\n\n# ============================================\n# 5. DATALOADERS\n# ============================================\nbatch_size = 64\ntrain_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True, num_workers=2)\nval_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False, num_workers=2)\ntest_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False, num_workers=2)\n\n# ============================================\n# 6. VÉRIFICATION\n# ============================================\nprint(\"\\n📊 Vérification:\")\nfor images, labels in train_loader:\n    print(f\"   Shape: {images.shape}\")  # Doit afficher (64, 3, 96, 96)\n    print(f\"   min: {images.min():.3f}, max: {images.max():.3f}\")\n    break\n\nprint(f\"\\n✅ Prêt !\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T06:22:27.789442Z","iopub.execute_input":"2026-04-30T06:22:27.789734Z","iopub.status.idle":"2026-04-30T06:23:21.852030Z","shell.execute_reply.started":"2026-04-30T06:22:27.789712Z","shell.execute_reply":"2026-04-30T06:23:21.851114Z"}},"outputs":[{"name":"stdout","text":"Chargement du dataset en RAM (patience...)\n✅ 17736 images chargées !\nTrain: 11350, Val: 2838, Test: 3548\n\n📊 Vérification:\n   Shape: torch.Size([64, 3, 96, 96])\n   min: 0.000, max: 1.000\n\n✅ Prêt !\n","output_type":"stream"}],"execution_count":9},{"id":"bfdaeda3d05566f7","cell_type":"markdown","source":"### Distribution des classes","metadata":{"id":"bfdaeda3d05566f7"}},{"id":"bbf54246-5077-476f-b836-5a7e5a5a9f10","cell_type":"code","source":"import matplotlib.pyplot as plt\n\n# Les noms officiels selon la documentation DECaLS\ngalaxy10_cls_names = [\n    \"Disturbed Galaxies\",              # Classe 0\n    \"Merging Galaxies\",                # Classe 1\n    \"Round Smooth Galaxies\",           # Classe 2\n    \"In-between Round Smooth Galaxies\",# Classe 3\n    \"Cigar Shaped Smooth Galaxies\",    # Classe 4\n    \"Barred Spiral Galaxies\",          # Classe 5\n    \"Unbarred Tight Spiral Galaxies\",  # Classe 6\n    \"Unbarred Loose Spiral Galaxies\",  # Classe 7\n    \"Edge-on Galaxies without Bulge\",  # Classe 8\n    \"Edge-on Galaxies with Bulge\"      # Classe 9\n] \n\n# Récupérer tous les labels du dataset pour créer le tensor\n#with h5py.File(dataset.h5_path, 'r') as f:\n#   labels_tensor = torch.tensor(f['ans'][:], dtype=torch.long)\n\n# compter le nombre de classes et afficher l'histogramme\nnum_classes = len(torch.unique(labels_tensor))\n\n# Compter les occurrences de chaque classe\nclass_counts = torch.bincount(labels_tensor)\n\n# Affichage avec matplotlib\nplt.figure(figsize=(12, 6))\nplt.bar(range(num_classes), class_counts.numpy())\nplt.xlabel(\"Classe\")\nplt.ylabel(\"Nombre d'images\")\nplt.title(\"Distribution des classes dans Galaxy10 DECaLS\")\n\n# Remplacer les numéros (0,1,2...) par les noms des classes\nplt.xticks(range(num_classes), galaxy10_cls_names, rotation=45, ha='right', fontsize=8)\nplt.tight_layout()\nplt.show()\n\n# Afficher les noms des classes\nprint(\"\\nClasses Galaxy10 DECaLS :\")\nfor i in range(10):\n    print(f\"Classe {i}: {galaxy10_cls_names[i]}\")\n","metadata":{"execution":{"iopub.status.busy":"2026-04-26T20:00:18.659989Z","iopub.status.idle":"2026-04-26T20:00:18.660213Z","shell.execute_reply.started":"2026-04-26T20:00:18.660104Z","shell.execute_reply":"2026-04-26T20:00:18.660117Z"},"trusted":true},"outputs":[],"execution_count":null},{"id":"e4497d69-54bc-4f0c-8329-fed5255baaab","cell_type":"markdown","source":"## 1. vérification du GPU","metadata":{}},{"id":"sqd2bKJxfys1","cell_type":"code","source":"import os\nimport torch\n\n\n\nprint(\"GPU disponible :\", torch.cuda.is_available())\n","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"execution":{"iopub.status.busy":"2026-04-26T20:14:14.798271Z","iopub.execute_input":"2026-04-26T20:14:14.798598Z","iopub.status.idle":"2026-04-26T20:14:14.803380Z","shell.execute_reply.started":"2026-04-26T20:14:14.798569Z","shell.execute_reply":"2026-04-26T20:14:14.802752Z"},"executionInfo":{"elapsed":20434,"status":"ok","timestamp":1777066841572,"user":{"displayName":"Rama Kdj","userId":"05689091522843985216"},"user_tz":-60},"id":"sqd2bKJxfys1","outputId":"8e58161c-27e9-4687-b7a3-9342ea1c33d5","trusted":true},"outputs":[{"name":"stdout","text":"GPU disponible : True\n","output_type":"stream"}],"execution_count":10},{"id":"0e6dbdd0-022c-4b75-8e9f-68bde35a20fb","cell_type":"markdown","source":"## 2. Autre Importation des bibliothèques nécessaires","metadata":{}},{"id":"92e2f322-8616-4105-aa9f-cf9b7045530d","cell_type":"code","source":"import os\nimport time\nimport h5py\nfrom tqdm.notebook import tqdm\nfrom sklearn.metrics import classification_report, confusion_matrix\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader","metadata":{"execution":{"iopub.status.busy":"2026-04-30T15:48:20.653279Z","iopub.execute_input":"2026-04-30T15:48:20.653620Z","iopub.status.idle":"2026-04-30T15:48:20.942869Z","shell.execute_reply.started":"2026-04-30T15:48:20.653591Z","shell.execute_reply":"2026-04-30T15:48:20.942191Z"},"trusted":true},"outputs":[],"execution_count":2},{"id":"95e8420e-2fa1-43b8-ac2b-e8ae7c3f65d0","cell_type":"markdown","source":"# Best modele pour 96×96","metadata":{}},{"id":"74e64291-2a57-4336-9097-57737da83078","cell_type":"code","source":"device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device utilisé :\", device)\nclass GalaxyCNN_6layers_96(nn.Module):\n    def __init__(self, num_classes=10):\n        super().__init__()\n        self.conv1 = nn.Conv2d(3, 8, 3, padding=1)\n        self.bn1 = nn.BatchNorm2d(8)\n        self.conv2 = nn.Conv2d(8, 16, 3, padding=1)\n        self.bn2 = nn.BatchNorm2d(16)\n        self.conv3 = nn.Conv2d(16, 32, 3, padding=1)\n        self.bn3 = nn.BatchNorm2d(32)\n        self.conv4 = nn.Conv2d(32, 64, 3, padding=1)\n        self.bn4 = nn.BatchNorm2d(64)\n        self.conv5 = nn.Conv2d(64, 64, 3, padding=1)\n        self.bn5 = nn.BatchNorm2d(64)\n        self.conv6 = nn.Conv2d(64, 64, 3, padding=1)\n        self.bn6 = nn.BatchNorm2d(64)\n        self.pool = nn.MaxPool2d(2, 2)\n        self.dropout = nn.Dropout(0.35)\n        \n        # ✅ Pour 96×96 : après 6 poolings → 96/64 = 1.5 → 1×1\n        self.fc1 = nn.Linear(64 * 1 * 1, 128)   # 64 × 1 × 1 = 64\n        self.fc2 = nn.Linear(128, num_classes)\n\n    def forward(self, x):\n        x = self.pool(F.relu(self.bn1(self.conv1(x))))\n        x = self.pool(F.relu(self.bn2(self.conv2(x))))\n        x = self.pool(F.relu(self.bn3(self.conv3(x))))\n        x = self.pool(F.relu(self.bn4(self.conv4(x))))\n        x = self.pool(F.relu(self.bn5(self.conv5(x))))\n        x = self.pool(F.relu(self.bn6(self.conv6(x))))\n        x = x.view(x.size(0), -1)\n        x = self.dropout(F.relu(self.fc1(x)))\n        x = self.fc2(x)\n        return x\n       \n\n\n\nmodel = GalaxyCNN_6layers_96().to(device)\ncriterion = nn.CrossEntropyLoss()\noptimizer = torch.optim.Adam(model.parameters(), lr=0.001)\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', patience=3, factor=0.5)\n\nprint(f\"Nombre de paramètres : {sum(p.numel() for p in model.parameters()):,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T15:48:26.093586Z","iopub.execute_input":"2026-04-30T15:48:26.094410Z","iopub.status.idle":"2026-04-30T15:48:26.676192Z","shell.execute_reply.started":"2026-04-30T15:48:26.094378Z","shell.execute_reply":"2026-04-30T15:48:26.675497Z"}},"outputs":[{"name":"stdout","text":"Device utilisé : cuda\nNombre de paramètres : 108,490\n","output_type":"stream"}],"execution_count":3},{"id":"77b77410-67e0-413c-bb1d-ce98b838c509","cell_type":"code","source":"summary(model, (3, 96, 96))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T15:48:53.639685Z","iopub.execute_input":"2026-04-30T15:48:53.640515Z","iopub.status.idle":"2026-04-30T15:48:54.373433Z","shell.execute_reply.started":"2026-04-30T15:48:53.640483Z","shell.execute_reply":"2026-04-30T15:48:54.372614Z"}},"outputs":[{"name":"stdout","text":"----------------------------------------------------------------\n        Layer (type)               Output Shape         Param #\n================================================================\n            Conv2d-1            [-1, 8, 96, 96]             224\n       BatchNorm2d-2            [-1, 8, 96, 96]              16\n         MaxPool2d-3            [-1, 8, 48, 48]               0\n            Conv2d-4           [-1, 16, 48, 48]           1,168\n       BatchNorm2d-5           [-1, 16, 48, 48]              32\n         MaxPool2d-6           [-1, 16, 24, 24]               0\n            Conv2d-7           [-1, 32, 24, 24]           4,640\n       BatchNorm2d-8           [-1, 32, 24, 24]              64\n         MaxPool2d-9           [-1, 32, 12, 12]               0\n           Conv2d-10           [-1, 64, 12, 12]          18,496\n      BatchNorm2d-11           [-1, 64, 12, 12]             128\n        MaxPool2d-12             [-1, 64, 6, 6]               0\n           Conv2d-13             [-1, 64, 6, 6]          36,928\n      BatchNorm2d-14             [-1, 64, 6, 6]             128\n        MaxPool2d-15             [-1, 64, 3, 3]               0\n           Conv2d-16             [-1, 64, 3, 3]          36,928\n      BatchNorm2d-17             [-1, 64, 3, 3]             128\n        MaxPool2d-18             [-1, 64, 1, 1]               0\n           Linear-19                  [-1, 128]           8,320\n          Dropout-20                  [-1, 128]               0\n           Linear-21                   [-1, 10]           1,290\n================================================================\nTotal params: 108,490\nTrainable params: 108,490\nNon-trainable params: 0\n----------------------------------------------------------------\nInput size (MB): 0.11\nForward/backward pass size (MB): 2.42\nParams size (MB): 0.41\nEstimated Total Size (MB): 2.94\n----------------------------------------------------------------\n","output_type":"stream"}],"execution_count":4},{"id":"7396823f-5b51-480c-9080-cc53fdb5b61a","cell_type":"markdown","source":"## 8. Entraînement avec sauvegarde après chaque époque et sauvegarde du meilleur modèle","metadata":{}},{"id":"dc8065cd-5d10-483b-ba3f-95795408a90d","cell_type":"code","source":"import os\nimport time\nfrom tqdm import tqdm\n\nnum_epochs = 20\npatience = 5          # arrêt si pas d'amélioration pendant 5 époques\nhistory = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': []}\nbest_val_acc = 0.0\nsave_path = '/kaggle/working/' # Chemin spécifique à Kaggle\nprint(f\"L'entraînement tourne sur : {next(model.parameters()).device}\")\n\n# Compteur pour early stopping\nepochs_without_improve = 0\n\nfor epoch in range(num_epochs):\n    model.train()\n    train_loss = 0.0\n    train_correct = 0\n    train_total = 0\n    epoch_start = time.time()\n    loop = tqdm(train_loader, desc=f'Epoch {epoch+1}/{num_epochs}')\n    for images, labels in loop:\n        images, labels = images.to(device), labels.to(device)\n        optimizer.zero_grad()\n        outputs = model(images)\n        loss = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n\n        train_loss += loss.item()\n        _, pred = torch.max(outputs, 1)\n        train_total += labels.size(0)\n        train_correct += (pred == labels).sum().item()\n        loop.set_postfix(loss=loss.item())\n\n    train_loss /= len(train_loader)\n    train_acc = 100.0 * train_correct / train_total\n\n    # Validation\n    model.eval()\n    val_loss = 0.0\n    val_correct = 0\n    val_total = 0\n    with torch.no_grad():\n        for images, labels in val_loader:\n            images, labels = images.to(device), labels.to(device)\n            outputs = model(images)\n            loss = criterion(outputs, labels)\n            val_loss += loss.item()\n            _, pred = torch.max(outputs, 1)\n            val_total += labels.size(0)\n            val_correct += (pred == labels).sum().item()\n    val_loss /= len(val_loader)\n    val_acc = 100.0 * val_correct / val_total\n\n    epoch_time = time.time() - epoch_start\n\n    # Mise à jour de l'historique\n    history['train_loss'].append(train_loss)\n    history['train_acc'].append(train_acc)\n    history['val_loss'].append(val_loss)\n    history['val_acc'].append(val_acc)\n\n    # 1. Sauvegarde du meilleur modèle + suivi early stopping\n    if val_acc > best_val_acc:\n        best_val_acc = val_acc\n        best_model_path = os.path.join(save_path, 'best_model_2layers.pth')\n        torch.save(model.state_dict(), best_model_path)\n        epochs_without_improve = 0\n        print(f\"  ✅ Meilleur modèle sauvegardé (val_acc = {val_acc:.2f}%)\")\n    else:\n        epochs_without_improve += 1\n        print(f\"  ⏳ Pas d'amélioration ({epochs_without_improve}/{patience})\")\n\n    # 2. Early stopping\n    if epochs_without_improve >= patience:\n        print(f\"🛑 Early stopping déclenché après {epoch+1} époques.\")\n        break\n\n    # 3. Suppression du checkpoint précédent pour gagner de la place\n    if epoch > 0:\n        old_checkpoint = os.path.join(save_path, f'checkpoint_2layers_epoch_{epoch}.pth')\n        if os.path.exists(old_checkpoint):\n            os.remove(old_checkpoint)\n\n    # 4. Sauvegarde du nouveau checkpoint complet\n    current_checkpoint_path = os.path.join(save_path, f'checkpoint_2layers_epoch_{epoch+1}.pth')\n    checkpoint = {\n        'epoch': epoch,\n        'model_state_dict': model.state_dict(),\n        'optimizer_state_dict': optimizer.state_dict(),\n        'val_acc': val_acc,\n        'history': history\n    }\n    torch.save(checkpoint, current_checkpoint_path)\n\n    print(f\"📊 Epoch {epoch+1}/{num_epochs} - Temps: {epoch_time:.1f}s\")\n    print(f\"   Train - Loss: {train_loss:.4f}, Acc: {train_acc:.2f}%\")\n    print(f\"   Val   - Loss: {val_loss:.4f}, Acc: {val_acc:.2f}%\")\n    print(f\"   💾 Checkpoint mis à jour (epoch {epoch+1})\")\n    print(\"-\" * 60)\n\n    scheduler.step(val_loss)\n\nprint(f\"✅ Entraînement terminé - Meilleure validation accuracy: {best_val_acc:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-30T06:24:39.494383Z","iopub.execute_input":"2026-04-30T06:24:39.494913Z","iopub.status.idle":"2026-04-30T06:29:16.852079Z","shell.execute_reply.started":"2026-04-30T06:24:39.494884Z","shell.execute_reply":"2026-04-30T06:29:16.851154Z"}},"outputs":[{"name":"stdout","text":"L'entraînement tourne sur : cuda:0\n","output_type":"stream"},{"name":"stderr","text":"Epoch 1/20: 100%|██████████| 178/178 [00:13<00:00, 12.86it/s, loss=1.8] \n","output_type":"stream"},{"name":"stdout","text":"  ✅ Meilleur modèle sauvegardé (val_acc = 45.28%)\n📊 Epoch 1/20 - Temps: 15.8s\n   Train - Loss: 1.6702, Acc: 37.82%\n   Val   - Loss: 1.4130, Acc: 45.28%\n   💾 Checkpoint mis à jour (epoch 1)\n------------------------------------------------------------\n","output_type":"stream"},{"name":"stderr","text":"Epoch 2/20: 100%|███████